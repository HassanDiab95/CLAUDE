CLASS ZCL_SD_MASS_CHANGE DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    TYPES TT_VBELN_RANGE TYPE RANGE OF VBELN_VA.

    METHODS RUN
      IMPORTING IT_VBELN TYPE TT_VBELN_RANGE.

  PRIVATE SECTION.

    TYPES: BEGIN OF TY_OUTPUTDATA,
             VBELN TYPE VBAK-VBELN,
             POSNR TYPE VBAP-POSNR,
             MATNR TYPE VBAP-MATNR,
             LFSTA TYPE VBAP-LFSTA,
             ABGRU TYPE VBAP-ABGRU,
           END OF TY_OUTPUTDATA,
           TT_OUTPUTDATA TYPE STANDARD TABLE OF TY_OUTPUTDATA WITH EMPTY KEY.

    TYPES: BEGIN OF TY_RESULT,
             STATUS   TYPE ICON_D,
             VBELN    TYPE VBELN_VA,
             POSNR    TYPE POSNR_VA,
             MATNR    TYPE MATNR,
             MESSAGE  TYPE STRING,
             BAPI_MSG TYPE STRING,
           END OF TY_RESULT,
           TT_RESULT TYPE STANDARD TABLE OF TY_RESULT WITH EMPTY KEY.

    DATA MT_RESULT TYPE TT_RESULT.

    CONSTANTS GC_ERROR   TYPE STRING VALUE 'An error occured, no change done to the sales order.'.
    CONSTANTS GC_SUCCESS TYPE STRING VALUE 'Sales order changed successfully.'.

    METHODS SELECT_ITEMS
      IMPORTING IT_VBELN        TYPE TT_VBELN_RANGE
      RETURNING VALUE(RT_ITEMS) TYPE TT_OUTPUTDATA.

    METHODS CHANGE_ORDER
      IMPORTING IV_VBELN TYPE VBELN_VA
                IT_ITEMS TYPE TT_OUTPUTDATA.

    METHODS DISPLAY.

ENDCLASS.

CLASS ZCL_SD_MASS_CHANGE IMPLEMENTATION.

  METHOD RUN.

    CHECK IT_VBELN IS NOT INITIAL.

    DATA(LT_ITEMS) = SELECT_ITEMS( IT_VBELN ).

    LOOP AT LT_ITEMS INTO DATA(LS_ITEM) GROUP BY LS_ITEM-VBELN INTO DATA(LV_VBELN).
      CHANGE_ORDER( IV_VBELN = LV_VBELN
                    IT_ITEMS = VALUE #( FOR LS_MEMBER IN GROUP LV_VBELN ( LS_MEMBER ) ) ).
    ENDLOOP.

    DISPLAY( ).

  ENDMETHOD.

  METHOD SELECT_ITEMS.

    SELECT VBAK~VBELN, VBAP~POSNR, VBAP~MATNR, VBAP~LFSTA
      FROM VBAK
      INNER JOIN VBAP ON VBAK~VBELN = VBAP~VBELN
      WHERE VBAK~VKORG IN ( '1200', '1500', '1600' )
        AND VBAK~VBELN IN @IT_VBELN
        AND VBAK~VBTYP <> 'B'
        AND VBAK~GBSTK <> 'C'
        AND VBAP~LFSTA <> 'C'
        AND VBAP~ABGRU <> '00'
      INTO CORRESPONDING FIELDS OF TABLE @RT_ITEMS.

    SORT RT_ITEMS BY VBELN.

  ENDMETHOD.

  METHOD CHANGE_ORDER.

    DATA LT_ITEM_IN  TYPE STANDARD TABLE OF BAPISDITM  WITH EMPTY KEY.
    DATA LT_ITEM_INX TYPE STANDARD TABLE OF BAPISDITMX WITH EMPTY KEY.
    DATA LT_RETURN   TYPE STANDARD TABLE OF BAPIRET2   WITH EMPTY KEY.

    DATA(LS_ITEM_HEDX) = VALUE BAPISDH1X( UPDATEFLAG = 'U' ).

    LT_ITEM_IN  = VALUE #( FOR LS_ITEM IN IT_ITEMS ( MATERIAL   = LS_ITEM-MATNR
                                                     ITM_NUMBER = LS_ITEM-POSNR
                                                     REASON_REJ = '00' ) ).

    LT_ITEM_INX = VALUE #( FOR LS_ITEM IN IT_ITEMS ( ITM_NUMBER = LS_ITEM-POSNR
                                                     REASON_REJ = 'X'
                                                     UPDATEFLAG = 'U' ) ).

    CALL FUNCTION 'BAPI_SALESORDER_CHANGE' "#EC CI_USAGE_OK[2438131]
      EXPORTING
        SALESDOCUMENT    = IV_VBELN
        ORDER_HEADER_INX = LS_ITEM_HEDX
      TABLES
        RETURN           = LT_RETURN
        ORDER_ITEM_IN    = LT_ITEM_IN
        ORDER_ITEM_INX   = LT_ITEM_INX.

    LOOP AT LT_RETURN TRANSPORTING NO FIELDS WHERE TYPE EQ 'E' OR TYPE EQ 'A'.
      EXIT.
    ENDLOOP.

    DATA(LV_ERROR) = XSDBOOL( SY-SUBRC EQ 0 ).

    IF LV_ERROR = ABAP_TRUE.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          WAIT = ABAP_TRUE.
    ENDIF.

    DATA(LV_BAPI_MSG) = REDUCE STRING( INIT LV_MSG = ``
                                       FOR LS_RETURN IN LT_RETURN
                                       WHERE ( TYPE = 'E' OR TYPE = 'A' )
                                       NEXT LV_MSG = COND #( WHEN LV_MSG IS INITIAL
                                                             THEN LS_RETURN-MESSAGE
                                                             ELSE |{ LV_MSG } / { LS_RETURN-MESSAGE }| ) ).

    LOOP AT IT_ITEMS INTO DATA(LS_OUT).
      APPEND VALUE #( STATUS   = COND #( WHEN LV_ERROR = ABAP_TRUE THEN ICON_LED_RED ELSE ICON_LED_GREEN )
                      VBELN    = LS_OUT-VBELN
                      POSNR    = LS_OUT-POSNR
                      MATNR    = LS_OUT-MATNR
                      MESSAGE  = COND #( WHEN LV_ERROR = ABAP_TRUE THEN GC_ERROR ELSE GC_SUCCESS )
                      BAPI_MSG = LV_BAPI_MSG ) TO MT_RESULT.
    ENDLOOP.

  ENDMETHOD.

  METHOD DISPLAY.

    IF MT_RESULT IS INITIAL.
      MESSAGE 'No sales order to change' TYPE 'S'.
      RETURN.
    ENDIF.

    TRY.
        CL_SALV_TABLE=>FACTORY( IMPORTING R_SALV_TABLE = DATA(LO_ALV)
                                CHANGING  T_TABLE      = MT_RESULT ).

        DATA(LO_COLS) = LO_ALV->GET_COLUMNS( ).
        LO_COLS->SET_OPTIMIZE( ABAP_TRUE ).

        DATA(LO_STATUS) = CAST CL_SALV_COLUMN_TABLE( LO_COLS->GET_COLUMN( 'STATUS' ) ).
        LO_STATUS->SET_ICON( IF_SALV_C_BOOL_SAP=>TRUE ).
        LO_STATUS->SET_SHORT_TEXT( 'Status' ).
        LO_STATUS->SET_MEDIUM_TEXT( 'Status' ).
        LO_STATUS->SET_LONG_TEXT( 'Status' ).

        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_SHORT_TEXT( 'Message' ).
        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_MEDIUM_TEXT( 'Message' ).
        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_LONG_TEXT( 'Message' ).

        LO_COLS->GET_COLUMN( 'BAPI_MSG' )->SET_SHORT_TEXT( 'BAPI msg' ).
        LO_COLS->GET_COLUMN( 'BAPI_MSG' )->SET_MEDIUM_TEXT( 'BAPI message' ).
        LO_COLS->GET_COLUMN( 'BAPI_MSG' )->SET_LONG_TEXT( 'BAPI error message' ).

        DATA(LO_SORTS) = LO_ALV->GET_SORTS( ).
        LO_SORTS->ADD_SORT( COLUMNNAME = 'VBELN' SUBTOTAL = ABAP_FALSE ).

        LO_ALV->GET_FUNCTIONS( )->SET_ALL( ABAP_TRUE ).
        LO_ALV->GET_DISPLAY_SETTINGS( )->SET_STRIPED_PATTERN( ABAP_TRUE ).
        LO_ALV->DISPLAY( ).

      CATCH CX_SALV_MSG CX_SALV_NOT_FOUND CX_SALV_EXISTING CX_SALV_DATA_ERROR.
        MESSAGE 'Result list could not be displayed' TYPE 'S' DISPLAY LIKE 'E'.
    ENDTRY.

  ENDMETHOD.

ENDCLASS.
