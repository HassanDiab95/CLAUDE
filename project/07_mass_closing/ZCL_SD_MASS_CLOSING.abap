CLASS ZCL_SD_MASS_CLOSING DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    TYPES TT_VBELN_RANGE TYPE RANGE OF VBELN_VA.

    TYPES: BEGIN OF TY_RESULT,
             STATUS  TYPE ICON_D,
             VBELN   TYPE VBELN_VA,
             ITEMS   TYPE STRING,
             MESSAGE TYPE STRING,
           END OF TY_RESULT,
           TT_RESULT TYPE STANDARD TABLE OF TY_RESULT WITH EMPTY KEY.

    METHODS RUN
      IMPORTING IT_VBELN TYPE TT_VBELN_RANGE OPTIONAL.

    METHODS EXECUTE
      IMPORTING IT_VBELN         TYPE TT_VBELN_RANGE OPTIONAL
      RETURNING VALUE(RT_RESULT) TYPE TT_RESULT.

  PRIVATE SECTION.

    TYPES: BEGIN OF TY_ITEM,
             VBELN TYPE VBELN_VA,
             POSNR TYPE POSNR_VA,
             MATNR TYPE MATNR,
           END OF TY_ITEM,
           TT_ITEM TYPE STANDARD TABLE OF TY_ITEM WITH EMPTY KEY.

    CONSTANTS GC_DAYS    TYPE I        VALUE 90.
    CONSTANTS GC_ABGRU   TYPE ABGRU_VA VALUE '00'.
    CONSTANTS GC_ERROR   TYPE STRING   VALUE 'An error occured, no change done to the sales order.'.
    CONSTANTS GC_SUCCESS TYPE STRING   VALUE 'Sales order changed successfully.'.

    METHODS SELECT_ITEMS
      IMPORTING IT_VBELN        TYPE TT_VBELN_RANGE
      RETURNING VALUE(RT_ITEMS) TYPE TT_ITEM.

    METHODS CLOSE_ORDER
      IMPORTING IV_VBELN         TYPE VBELN_VA
                IT_ITEMS         TYPE TT_ITEM
      RETURNING VALUE(RS_RESULT) TYPE TY_RESULT.

    METHODS ITEM_LIST
      IMPORTING IT_ITEMS       TYPE TT_ITEM
      RETURNING VALUE(RV_LIST) TYPE STRING.

    METHODS DISPLAY
      IMPORTING IT_RESULT TYPE TT_RESULT.

ENDCLASS.

CLASS ZCL_SD_MASS_CLOSING IMPLEMENTATION.

  METHOD RUN.

    DISPLAY( EXECUTE( IT_VBELN ) ).

  ENDMETHOD.

  METHOD EXECUTE.

    DATA(LT_ITEMS) = SELECT_ITEMS( IT_VBELN ).

    LOOP AT LT_ITEMS INTO DATA(LS_ITEM) GROUP BY LS_ITEM-VBELN INTO DATA(LV_VBELN).
      APPEND CLOSE_ORDER( IV_VBELN = LV_VBELN
                          IT_ITEMS = VALUE #( FOR LS_MEMBER IN GROUP LV_VBELN ( LS_MEMBER ) ) )
        TO RT_RESULT.
    ENDLOOP.

  ENDMETHOD.

  METHOD SELECT_ITEMS.

    DATA(LV_DATE) = CONV ERDAT( SY-DATUM - GC_DAYS ).

    SELECT P~VBELN, P~POSNR, P~MATNR
      FROM VBAK AS K
      INNER JOIN VBAP AS P ON P~VBELN = K~VBELN
      WHERE K~VKORG IN ( '1200', '1500', '1600' )
        AND K~ERDAT <= @LV_DATE
        AND K~VBELN IN @IT_VBELN
        AND K~VBTYP <> 'B'
        AND K~GBSTK <> 'C'
        AND P~LFSTA <> 'C'
        AND P~ABGRU = @SPACE
      ORDER BY P~VBELN, P~POSNR
      INTO TABLE @RT_ITEMS.

  ENDMETHOD.

  METHOD CLOSE_ORDER.

    DATA LT_IN     TYPE STANDARD TABLE OF BAPISDITM  WITH EMPTY KEY.
    DATA LT_INX    TYPE STANDARD TABLE OF BAPISDITMX WITH EMPTY KEY.
    DATA LT_RETURN TYPE BAPIRET2_T.

    DATA(LS_HDRX) = VALUE BAPISDH1X( UPDATEFLAG = 'U' ).

    LT_IN  = VALUE #( FOR LS_ITEM IN IT_ITEMS ( ITM_NUMBER = LS_ITEM-POSNR
                                                MATERIAL   = LS_ITEM-MATNR
                                                REASON_REJ = GC_ABGRU ) ).

    LT_INX = VALUE #( FOR LS_ITEM IN IT_ITEMS ( ITM_NUMBER = LS_ITEM-POSNR
                                                UPDATEFLAG = 'U'
                                                REASON_REJ = ABAP_TRUE ) ).

    CALL FUNCTION 'BAPI_SALESORDER_CHANGE' "#EC CI_USAGE_OK[2438131]
      EXPORTING
        SALESDOCUMENT    = IV_VBELN
        ORDER_HEADER_INX = LS_HDRX
      TABLES
        RETURN           = LT_RETURN
        ORDER_ITEM_IN    = LT_IN
        ORDER_ITEM_INX   = LT_INX.

    RS_RESULT = VALUE #( VBELN = IV_VBELN
                         ITEMS = ITEM_LIST( IT_ITEMS ) ).

    LOOP AT LT_RETURN INTO DATA(LS_RETURN) WHERE TYPE = 'E' OR TYPE = 'A'.
      EXIT.
    ENDLOOP.

    IF SY-SUBRC = 0.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      RS_RESULT-STATUS  = ICON_LED_RED.
      RS_RESULT-MESSAGE = |{ GC_ERROR } { LS_RETURN-MESSAGE }|.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          WAIT = ABAP_TRUE.
      RS_RESULT-STATUS  = ICON_LED_GREEN.
      RS_RESULT-MESSAGE = GC_SUCCESS.
    ENDIF.

  ENDMETHOD.

  METHOD ITEM_LIST.

    RV_LIST = REDUCE STRING( INIT LV_LIST = ``
                             FOR LS_ITEM IN IT_ITEMS
                             NEXT LV_LIST = COND #( WHEN LV_LIST IS INITIAL
                                                    THEN |{ LS_ITEM-POSNR ALPHA = OUT }|
                                                    ELSE |{ LV_LIST }, { LS_ITEM-POSNR ALPHA = OUT }| ) ).

  ENDMETHOD.

  METHOD DISPLAY.

    DATA(LT_RESULT) = IT_RESULT.

    IF LT_RESULT IS INITIAL.
      MESSAGE 'No sales order to close' TYPE 'S'.
      RETURN.
    ENDIF.

    TRY.
        CL_SALV_TABLE=>FACTORY( IMPORTING R_SALV_TABLE = DATA(LO_ALV)
                                CHANGING  T_TABLE      = LT_RESULT ).

        DATA(LO_COLS) = LO_ALV->GET_COLUMNS( ).
        LO_COLS->SET_OPTIMIZE( ABAP_TRUE ).

        DATA(LO_STATUS) = CAST CL_SALV_COLUMN_TABLE( LO_COLS->GET_COLUMN( 'STATUS' ) ).
        LO_STATUS->SET_ICON( IF_SALV_C_BOOL_SAP=>TRUE ).
        LO_STATUS->SET_LONG_TEXT( 'Status' ).

        LO_COLS->GET_COLUMN( 'ITEMS' )->SET_LONG_TEXT( 'Items rejected' ).
        LO_COLS->GET_COLUMN( 'ITEMS' )->SET_MEDIUM_TEXT( 'Items' ).
        LO_COLS->GET_COLUMN( 'ITEMS' )->SET_SHORT_TEXT( 'Items' ).
        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_LONG_TEXT( 'Message' ).
        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_MEDIUM_TEXT( 'Message' ).
        LO_COLS->GET_COLUMN( 'MESSAGE' )->SET_SHORT_TEXT( 'Message' ).

        LO_ALV->GET_FUNCTIONS( )->SET_ALL( ABAP_TRUE ).
        LO_ALV->DISPLAY( ).

      CATCH CX_SALV_MSG CX_SALV_NOT_FOUND.
        MESSAGE 'Result list could not be displayed' TYPE 'S' DISPLAY LIKE 'E'.
    ENDTRY.

  ENDMETHOD.

ENDCLASS.
