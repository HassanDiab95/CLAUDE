*&---------------------------------------------------------------------*
*& Report ZSD_SO_REL_MONITOR   (transaction ZSD_SO_REL_MON)
*&---------------------------------------------------------------------*
*& Monitor of the release cycle: one line per order item with costing,
*& credit and production status. Double click on a line shows the
*& history (ZSD_SO_REL_LOG) of the order.
*& DRAFT - not compiled / not tested in SAP
*&---------------------------------------------------------------------*
REPORT ZSD_SO_REL_MONITOR.

TABLES ZSD_SO_REL_H.

SELECT-OPTIONS S_VBELN FOR ZSD_SO_REL_H-VBELN.
SELECT-OPTIONS S_VKORG FOR ZSD_SO_REL_H-VKORG.
SELECT-OPTIONS S_AUART FOR ZSD_SO_REL_H-AUART.
SELECT-OPTIONS S_ERDAT FOR ZSD_SO_REL_H-ERDAT.
SELECT-OPTIONS S_OVER  FOR ZSD_SO_REL_H-OVERALL_STATUS.

TYPES: BEGIN OF TY_S_OUT,
         VBELN          TYPE ZSD_SO_REL_H-VBELN,
         POSNR          TYPE ZSD_SO_REL_I-POSNR,
         VKORG          TYPE ZSD_SO_REL_H-VKORG,
         AUART          TYPE ZSD_SO_REL_H-AUART,
         ERDAT          TYPE ZSD_SO_REL_H-ERDAT,
         OVERALL_STATUS TYPE ZSD_SO_REL_H-OVERALL_STATUS,
         CREDIT_STATUS  TYPE ZSD_SO_REL_H-CREDIT_STATUS,
         CREDIT_CYCLE   TYPE ZSD_SO_REL_H-CREDIT_CYCLE,
         WI_ID          TYPE ZSD_SO_REL_H-WI_ID,
         ITEM_COST      TYPE ZSD_SO_REL_I-COST_STATUS,
         ITEM_PROD      TYPE ZSD_SO_REL_I-PROD_STATUS,
         PROD_REL_ON    TYPE ZSD_SO_REL_I-PROD_REL_ON,
         SNAP_NETWR     TYPE ZSD_SO_REL_H-SNAP_NETWR,
         SNAP_WAERK     TYPE ZSD_SO_REL_H-SNAP_WAERK,
         CHANGED_ON     TYPE ZSD_SO_REL_H-CHANGED_ON,
         CHANGED_BY     TYPE ZSD_SO_REL_H-CHANGED_BY,
       END OF TY_S_OUT.

DATA GT_OUT TYPE STANDARD TABLE OF TY_S_OUT WITH EMPTY KEY.

CLASS LCL_EVENTS DEFINITION.
  PUBLIC SECTION.
    CLASS-METHODS ON_DOUBLE_CLICK
      FOR EVENT DOUBLE_CLICK OF CL_SALV_EVENTS_TABLE
      IMPORTING ROW.
ENDCLASS.

CLASS LCL_EVENTS IMPLEMENTATION.
  METHOD ON_DOUBLE_CLICK.

    DATA(LS_OUT) = VALUE TY_S_OUT( GT_OUT[ ROW ] OPTIONAL ).
    CHECK LS_OUT-VBELN IS NOT INITIAL.

    SELECT * FROM ZSD_SO_REL_LOG
      WHERE VBELN = @LS_OUT-VBELN
      ORDER BY LOG_TS DESCENDING
      INTO TABLE @DATA(LT_LOG).

    TRY.
        CL_SALV_TABLE=>FACTORY( IMPORTING R_SALV_TABLE = DATA(LO_LOG)
                                CHANGING  T_TABLE      = LT_LOG ).
        LO_LOG->GET_COLUMNS( )->SET_OPTIMIZE( ).
        LO_LOG->GET_DISPLAY_SETTINGS( )->SET_LIST_HEADER(
          |History of sales order { LS_OUT-VBELN ALPHA = OUT }| ).
        LO_LOG->SET_SCREEN_POPUP( START_COLUMN = 5  END_COLUMN = 160
                                  START_LINE   = 3  END_LINE   = 25 ).
        LO_LOG->DISPLAY( ).
      CATCH CX_SALV_MSG.
    ENDTRY.

  ENDMETHOD.
ENDCLASS.

START-OF-SELECTION.

  SELECT H~VBELN, I~POSNR, H~VKORG, H~AUART, H~ERDAT, H~OVERALL_STATUS,
         H~CREDIT_STATUS, H~CREDIT_CYCLE, H~WI_ID,
         I~COST_STATUS AS ITEM_COST, I~PROD_STATUS AS ITEM_PROD, I~PROD_REL_ON,
         H~SNAP_NETWR, H~SNAP_WAERK, H~CHANGED_ON, H~CHANGED_BY
    FROM ZSD_SO_REL_H AS H
    INNER JOIN ZSD_SO_REL_I AS I ON I~VBELN = H~VBELN
    WHERE H~VBELN          IN @S_VBELN
      AND H~VKORG          IN @S_VKORG
      AND H~AUART          IN @S_AUART
      AND H~ERDAT          IN @S_ERDAT
      AND H~OVERALL_STATUS IN @S_OVER
      AND I~PROD_RELEVANT  = 'X'
    ORDER BY H~VBELN, I~POSNR
    INTO CORRESPONDING FIELDS OF TABLE @GT_OUT.

  TRY.
      CL_SALV_TABLE=>FACTORY( IMPORTING R_SALV_TABLE = DATA(LO_ALV)
                              CHANGING  T_TABLE      = GT_OUT ).
      LO_ALV->GET_FUNCTIONS( )->SET_ALL( ).
      LO_ALV->GET_COLUMNS( )->SET_OPTIMIZE( ).
      LO_ALV->GET_DISPLAY_SETTINGS( )->SET_LIST_HEADER(
        'Sales order release cycle: YSDA/YSDAX - credit - production' ).
      SET HANDLER LCL_EVENTS=>ON_DOUBLE_CLICK FOR LO_ALV->GET_EVENT( ).
      LO_ALV->DISPLAY( ).
    CATCH CX_SALV_MSG INTO DATA(LX_SALV).
      MESSAGE LX_SALV TYPE 'I'.
  ENDTRY.
