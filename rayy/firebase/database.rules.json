{
  "rules": {
    ".read": false,
    ".write": false,
    "plants": {
      "$plantId": {
        ".read": "auth != null",
        "live":    { ".write": "auth != null" },
        "history": { ".write": "auth != null", ".indexOn": ["ts"] },
        "events":  { ".write": "auth != null", ".indexOn": ["ts"] },
        "command": { ".write": "auth != null" },
        "ai":      { ".write": "auth != null" },
        "config": {
          ".write": "auth != null",
          "moisture_min": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "moisture_max": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "muted":        { ".validate": "newData.isBoolean()" }
        }
      }
    }
  }
}
